---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';

const services = [
  {
    num: '壹',
    en: 'INVESTMENT CONSULTING',
    title: '投資策略諮詢',
    desc: '以價值投資為核心，協助你建立屬於自己的選股邏輯與資產配置框架。不追熱點、不跟風，只幫你找到適合長期持有的好公司。',
    items: ['個人投資組合健診', '選股邏輯建立', '風險承受度評估', '長期財務規劃討論'],
  },
  {
    num: '貳',
    en: 'FITNESS COACHING',
    title: '科學健身指導',
    desc: '依據運動科學原理，為你量身設計訓練計畫。從動作矯正到週期化訓練，幫助你建立可持續的健身習慣。',
    items: ['個人化訓練計畫設計', '動作技術指導', '營養搭配建議', '訓練進度追蹤'],
  },
  {
    num: '參',
    en: 'READING COMPANION',
    title: '閱讀陪伴計畫',
    desc: '為忙碌的現代人打造專屬閱讀清單，並提供深度導讀與讀書會主持服務。讓閱讀不再是孤獨的事，而是一場有人同行的思想旅程。',
    items: ['個人化書單推薦', '每月深度導讀報告', '線上讀書會主持', '書摘與重點整理'],
  },
  {
    num: '肆',
    en: 'WRITING & SPEAKING',
    title: '寫作課程與演講',
    desc: '分享知識寫作、部落格經營與個人品牌建立的實戰經驗。無論你是想開始寫作的新手，還是希望突破瓶頸的創作者，都歡迎一起探討。',
    items: ['知識寫作工作坊', '部落格從零開始課程', '企業內訓演講', '一對一寫作指導'],
  },
];
---

<PageLayout title="服務項目 — 布克小姐｜Booker" description="投資策略諮詢、科學健身指導、閱讀陪伴計畫與寫作課程">

  <PageHero label="Our Services" labelZh="服務項目" titleHtml="我能為你<em>做什麼</em>">
    多年來在投資、健身與文學三個領域的深耕，讓我有機會把這些積累轉化為對你有價值的服務。
  </PageHero>

  <section class="services-section">
    <div class="section-inner">
      {services.map(s => (
        <div class="service-block">
          <div class="service-side">
            <span class="service-num">{s.num}</span>
            <span class="label-en service-en">{s.en}</span>
          </div>
          <div class="service-main">
            <h2 class="service-title">{s.title}</h2>
            <p class="service-desc">{s.desc}</p>
            <ul class="service-items">
              {s.items.map(item => (
                <li class="service-item">{item}</li>
              ))}
            </ul>
            <a href="/contact" class="service-cta">預約諮詢 →</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="services-cta-band">
    <div class="services-cta-inner">
      <h2 class="services-cta-title">找不到你需要的服務？</h2>
      <p class="services-cta-desc">直接寫信告訴我你的需求，我們可以一起討論最適合的合作方式。</p>
      <a href="/contact" class="btn-primary">與我聯絡</a>
    </div>
  </section>

</PageLayout>

<style>
  .services-section { padding: 2rem 2rem 4rem; }

  .service-block {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 3rem;
    padding: 3rem 0.5rem;
    border-bottom: 1px solid var(--hairline);
  }
  .service-block:last-child { border-bottom: none; }

  .service-side {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .service-num {
    font-family: 'Noto Serif TC', serif;
    font-size: 3rem;
    font-weight: 600;
    color: var(--brown);
    opacity: 0.65;
    line-height: 1;
  }
  .service-en { margin: 0; letter-spacing: 0.3em; font-size: 0.62rem; }

  .service-title {
    font-size: 1.35rem;
    letter-spacing: 0.12em;
    margin: 0 0 0.9rem;
  }
  .service-desc {
    font-size: 0.9rem;
    color: var(--ink-muted);
    line-height: 2.1;
    letter-spacing: 0.04em;
    margin: 0 0 1.5rem;
    max-width: 560px;
  }
  .service-items {
    list-style: none;
    margin: 0 0 1.8rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 260px));
    gap: 0.55rem 2rem;
  }
  .service-item {
    font-size: 0.84rem;
    color: var(--ink-soft);
    letter-spacing: 0.06em;
    padding-left: 1.1rem;
    position: relative;
  }
  .service-item::before {
    content: '・';
    position: absolute;
    left: 0;
    color: var(--brown);
  }
  .service-cta {
    font-size: 0.82rem;
    color: var(--brown);
    letter-spacing: 0.14em;
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-strong);
    padding-bottom: 0.25rem;
    transition: color 0.2s, border-color 0.2s;
  }
  .service-cta:hover { color: var(--brown-deep); border-bottom-color: var(--brown); }

  .services-cta-band {
    padding: 4.5rem 2rem;
    text-align: center;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0px,
        transparent 9px,
        rgba(90, 72, 50, 0.035) 9px,
        rgba(90, 72, 50, 0.035) 10px
      ),
      var(--paper-warm);
    border-top: 1px solid var(--hairline);
  }
  .services-cta-inner { max-width: 560px; margin: 0 auto; }
  .services-cta-title {
    font-size: 1.35rem;
    letter-spacing: 0.12em;
    margin: 0 0 0.8rem;
  }
  .services-cta-desc {
    font-size: 0.87rem;
    color: var(--ink-muted);
    line-height: 2;
    letter-spacing: 0.05em;
    margin: 0 0 2rem;
  }

  @media (max-width: 760px) {
    .service-block { grid-template-columns: 1fr; gap: 1.2rem; padding: 2.2rem 0; }
    .service-side { flex-direction: row; align-items: baseline; gap: 1rem; }
    .service-items { grid-template-columns: 1fr; }
    /* 擴大觸控範圍到約 44px，不改變外觀 */
    .service-cta { position: relative; }
    .service-cta::after { content: ''; position: absolute; inset: -12px -8px; }
  }
</style>
