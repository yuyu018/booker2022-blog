---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import { servicesText as t, numeral } from '../lib/site';
---

<PageLayout title={t.seoTitle} description={t.seoDescription}>

  <PageHero label={t.heroLabelEn} labelZh={t.heroLabelZh} title={t.heroTitle} titleAccent={t.heroTitleAccent}>
    {t.heroDesc}
  </PageHero>

  <section class="services-section">
    <div class="section-inner">
      {t.services.map((s, i) => (
        <div class="service-block">
          <div class="service-side">
            <span class="service-num">{numeral(i)}</span>
            <span class="label-en service-en">{s.en}</span>
          </div>
          <div class="service-main">
            <h2 class="service-title">{s.title}</h2>
            <p class="service-desc">{s.desc}</p>
            <ul class="service-items">
              {s.items.map(item => (
                <li class="service-item">{item}</li>
              ))}
            </ul>
            <a href="/contact" class="service-cta">{t.itemCtaLabel}</a>
          </div>
        </div>
      ))}
      <p class="services-note">{t.note}</p>
    </div>
  </section>

  <section class="services-cta-band">
    <div class="services-cta-inner">
      <h2 class="services-cta-title">{t.ctaTitle}</h2>
      <p class="services-cta-desc">{t.ctaDesc}</p>
      <a href="/contact" class="btn-primary">{t.ctaButton}</a>
    </div>
  </section>

</PageLayout>

<style>
  .services-section { padding: 2rem 2rem 4rem; }

  .service-block {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 3rem;
    padding: 3rem 0.5rem;
    border-bottom: 1px solid var(--hairline);
  }
  .service-block:last-child { border-bottom: none; }

  .service-side {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .service-num {
    font-family: 'Noto Serif TC', serif;
    font-size: 3rem;
    font-weight: 600;
    color: var(--brown);
    opacity: 0.65;
    line-height: 1;
  }
  .service-en { margin: 0; letter-spacing: 0.3em; font-size: 0.62rem; }

  .service-title {
    font-size: 1.35rem;
    letter-spacing: 0.12em;
    margin: 0 0 0.9rem;
  }
  .service-desc {
    font-size: 0.9rem;
    color: var(--ink-muted);
    line-height: 2.1;
    letter-spacing: 0.04em;
    margin: 0 0 1.5rem;
    max-width: 560px;
  }
  .service-items {
    list-style: none;
    margin: 0 0 1.8rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 260px));
    gap: 0.55rem 2rem;
  }
  .service-item {
    font-size: 0.84rem;
    color: var(--ink-soft);
    letter-spacing: 0.06em;
    padding-left: 1.1rem;
    position: relative;
  }
  .service-item::before {
    content: '・';
    position: absolute;
    left: 0;
    color: var(--brown);
  }
  .service-cta {
    font-size: 0.82rem;
    color: var(--brown);
    letter-spacing: 0.14em;
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-strong);
    padding-bottom: 0.25rem;
    transition: color 0.2s, border-color 0.2s;
  }
  .service-cta:hover { color: var(--brown-deep); border-bottom-color: var(--brown); }

  .services-note {
    margin: 2.5rem 0 0;
    padding: 0.9rem 1.2rem;
    border-left: 2px solid var(--hairline-strong);
    font-size: 0.8rem;
    color: var(--ink-muted);
    letter-spacing: 0.05em;
    line-height: 2;
  }

  .services-cta-band {
    padding: 4.5rem 2rem;
    text-align: center;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0px,
        transparent 9px,
        rgba(90, 72, 50, 0.035) 9px,
        rgba(90, 72, 50, 0.035) 10px
      ),
      var(--paper-warm);
    border-top: 1px solid var(--hairline);
  }
  .services-cta-inner { max-width: 560px; margin: 0 auto; }
  .services-cta-title {
    font-size: 1.35rem;
    letter-spacing: 0.12em;
    margin: 0 0 0.8rem;
  }
  .services-cta-desc {
    font-size: 0.87rem;
    color: var(--ink-muted);
    line-height: 2;
    letter-spacing: 0.05em;
    margin: 0 0 2rem;
  }

  @media (max-width: 760px) {
    .service-block { grid-template-columns: 1fr; gap: 1.2rem; padding: 2.2rem 0; }
    .service-side { flex-direction: row; align-items: baseline; gap: 1rem; }
    .service-items { grid-template-columns: 1fr; }
    /* 擴大觸控範圍到約 44px，不改變外觀 */
    .service-cta { position: relative; }
    .service-cta::after { content: ''; position: absolute; inset: -12px -8px; }
  }
</style>
