---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';

const services = [
  {
    num: '壹',
    en: 'WRITING',
    title: '文章授權與邀稿',
    desc: '金錢觀念、閱讀筆記與生活隨筆的文章，歡迎洽談轉載授權，或依主題邀稿。',
    items: ['文章轉載授權', '主題專欄邀稿', '社群圖文合作', '電子報內容合作'],
  },
  {
    num: '貳',
    en: 'READING',
    title: '閱讀心得與書籍合作',
    desc: '讀完一本書，我習慣把畫線的句子和自己的生活連在一起寫下來。歡迎出版社與讀書會邀約。',
    items: ['新書閱讀心得', '書單推薦', '讀書會分享', '出版社合作'],
  },
  {
    num: '參',
    en: 'TALKS',
    title: '經驗分享與訪談',
    desc: '從月光族走到指數投資、上班族如何替自己安排成長，樂意用真實經驗和大家聊聊。',
    items: ['Podcast 訪談', '線上社團分享', '生活理財經驗分享', '自我成長主題對談'],
  },
  {
    num: '肆',
    en: 'COLLABORATION',
    title: '品牌與生活選品',
    desc: '只分享自己真心使用、理念相符的書籍、課程與生活用品。',
    items: ['產品體驗分享', '課程心得', '生活選品推薦', '合作洽談'],
  },
];
---

<PageLayout title="服務項目 — 布克小姐｜再富養一次" description="文章授權與邀稿、閱讀心得與書籍合作、經驗分享與訪談、品牌與生活選品">

  <PageHero label="Our Services" labelZh="服務項目" titleHtml="我能為你<em>做什麼</em>">
    我是一個上班族，也是一個持續記錄生活的寫作者。以下是我樂意參與的合作方式，歡迎來信聊聊。
  </PageHero>

  <section class="services-section">
    <div class="section-inner">
      {services.map(s => (
        <div class="service-block">
          <div class="service-side">
            <span class="service-num">{s.num}</span>
            <span class="label-en service-en">{s.en}</span>
          </div>
          <div class="service-main">
            <h2 class="service-title">{s.title}</h2>
            <p class="service-desc">{s.desc}</p>
            <ul class="service-items">
              {s.items.map(item => (
                <li class="service-item">{item}</li>
              ))}
            </ul>
            <a href="/contact" class="service-cta">來信洽談 →</a>
          </div>
        </div>
      ))}
      <p class="services-note">金錢相關文章皆為個人經驗分享，不提供個別投資建議或代客操作。</p>
    </div>
  </section>

  <section class="services-cta-band">
    <div class="services-cta-inner">
      <h2 class="services-cta-title">找不到你需要的服務？</h2>
      <p class="services-cta-desc">直接寫信告訴我你的需求，我們可以一起討論最適合的合作方式。</p>
      <a href="/contact" class="btn-primary">與我聯絡</a>
    </div>
  </section>

</PageLayout>

<style>
  .services-section { padding: 2rem 2rem 4rem; }

  .service-block {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 3rem;
    padding: 3rem 0.5rem;
    border-bottom: 1px solid var(--hairline);
  }
  .service-block:last-child { border-bottom: none; }

  .service-side {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .service-num {
    font-family: 'Noto Serif TC', serif;
    font-size: 3rem;
    font-weight: 600;
    color: var(--brown);
    opacity: 0.65;
    line-height: 1;
  }
  .service-en { margin: 0; letter-spacing: 0.3em; font-size: 0.62rem; }

  .service-title {
    font-size: 1.35rem;
    letter-spacing: 0.12em;
    margin: 0 0 0.9rem;
  }
  .service-desc {
    font-size: 0.9rem;
    color: var(--ink-muted);
    line-height: 2.1;
    letter-spacing: 0.04em;
    margin: 0 0 1.5rem;
    max-width: 560px;
  }
  .service-items {
    list-style: none;
    margin: 0 0 1.8rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 260px));
    gap: 0.55rem 2rem;
  }
  .service-item {
    font-size: 0.84rem;
    color: var(--ink-soft);
    letter-spacing: 0.06em;
    padding-left: 1.1rem;
    position: relative;
  }
  .service-item::before {
    content: '・';
    position: absolute;
    left: 0;
    color: var(--brown);
  }
  .service-cta {
    font-size: 0.82rem;
    color: var(--brown);
    letter-spacing: 0.14em;
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-strong);
    padding-bottom: 0.25rem;
    transition: color 0.2s, border-color 0.2s;
  }
  .service-cta:hover { color: var(--brown-deep); border-bottom-color: var(--brown); }

  .services-note {
    margin: 2.5rem 0 0;
    padding: 0.9rem 1.2rem;
    border-left: 2px solid var(--hairline-strong);
    font-size: 0.8rem;
    color: var(--ink-muted);
    letter-spacing: 0.05em;
    line-height: 2;
  }

  .services-cta-band {
    padding: 4.5rem 2rem;
    text-align: center;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0px,
        transparent 9px,
        rgba(90, 72, 50, 0.035) 9px,
        rgba(90, 72, 50, 0.035) 10px
      ),
      var(--paper-warm);
    border-top: 1px solid var(--hairline);
  }
  .services-cta-inner { max-width: 560px; margin: 0 auto; }
  .services-cta-title {
    font-size: 1.35rem;
    letter-spacing: 0.12em;
    margin: 0 0 0.8rem;
  }
  .services-cta-desc {
    font-size: 0.87rem;
    color: var(--ink-muted);
    line-height: 2;
    letter-spacing: 0.05em;
    margin: 0 0 2rem;
  }

  @media (max-width: 760px) {
    .service-block { grid-template-columns: 1fr; gap: 1.2rem; padding: 2.2rem 0; }
    .service-side { flex-direction: row; align-items: baseline; gap: 1rem; }
    .service-items { grid-template-columns: 1fr; }
    /* 擴大觸控範圍到約 44px，不改變外觀 */
    .service-cta { position: relative; }
    .service-cta::after { content: ''; position: absolute; inset: -12px -8px; }
  }
</style>
