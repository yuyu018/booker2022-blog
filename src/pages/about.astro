---
import PageLayout from '../layouts/PageLayout.astro';
import { aboutText as t, numeral } from '../lib/site';
---

<PageLayout title={t.seoTitle} description={t.seoDescription}>

  <!-- HERO -->
  <section class="about-hero">
    <div class="about-hero-inner">
      <div class="about-portrait">
        <div class="portrait-paper">
          <img class="portrait-img" src="/booker-avatar.png" alt="布克小姐" width="256" height="256" decoding="async" />
          <span class="portrait-caption">{t.portraitCaption}</span>
        </div>
        <span class="seal about-seal" aria-hidden="true">布克</span>
      </div>
      <div class="about-hero-text">
        <span class="label-en">{t.heroLabelEn}</span>
        <h1 class="about-hero-title">{t.heroTitleLine1}<br />{t.heroTitleLine2}</h1>
        <p class="about-hero-desc">
          {t.heroDesc}
        </p>
        <div class="about-tags">
          {t.heroTags.map(tag => <span class="about-tag">{tag}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- STORY -->
  <section class="story-section">
    <div class="story-inner">
      <span class="label-en">{t.storyLabelEn}</span>
      <h2 class="section-title">{t.storyTitle}</h2>
      {t.stories.map((s, i) => (
        <div class="story-block">
          <div class="story-side">
            <span class="story-num">{numeral(i)}</span>
          </div>
          <div class="story-main">
            <h3 class="story-title">{s.title}</h3>
            {s.paras.map(p => <p class="story-text">{p}</p>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- BELIEFS -->
  <section class="beliefs-band">
    <div class="beliefs-inner">
      <span class="label-en">{t.beliefsLabelEn}</span>
      <h2 class="section-title">{t.beliefsTitle}</h2>
      <div class="beliefs-grid">
        {t.beliefs.map(b => (
          <div class="belief">
            <h3 class="belief-title">{b.title}</h3>
            <p class="belief-desc">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="about-cta">
    <div class="about-cta-inner">
      <h2 class="about-cta-title">{t.ctaTitle}</h2>
      <p class="about-cta-desc">{t.ctaDesc}</p>
      <div class="about-cta-btns">
        <a href="/contact" class="btn-primary">{t.ctaBtnPrimary}</a>
        <a href="/blog" class="btn-secondary">{t.ctaBtnSecondary}</a>
      </div>
    </div>
  </section>

</PageLayout>

<style>
  /* ── HERO ── */
  .about-hero {
    padding: calc(var(--space-section) * 0.75) 2rem var(--space-section);
    border-bottom: 1px solid var(--hairline);
  }
  .about-hero-inner {
    max-width: var(--wide-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 270px 1fr;
    gap: 4.5rem;
    align-items: center;
  }
  .about-portrait { position: relative; }
  .portrait-paper {
    background: var(--bg-surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.4rem;
    padding: 2.4rem 1.5rem 1.8rem;
  }
  .portrait-img {
    width: 66%;
    height: auto;
    display: block;
  }
  .portrait-caption {
    font-size: 0.74rem;
    color: var(--ink-faint);
    letter-spacing: 0.26em;
  }
  .about-seal {
    position: absolute;
    right: -10px;
    bottom: -12px;
    font-size: 0.92rem;
  }
  .about-hero-title {
    font-size: clamp(1.5rem, 3.4vw, 2rem);
    letter-spacing: 0.1em;
    line-height: 1.6;
    margin: 0.4rem 0 1.2rem;
  }
  .about-hero-desc {
    font-family: 'Noto Serif TC', serif;
    font-size: 0.96rem;
    color: var(--ink-muted);
    font-weight: 300;
    line-height: 2.15;
    letter-spacing: 0.06em;
    margin: 0 0 1.8rem;
    max-width: 520px;
  }
  .about-tags { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .about-tag {
    font-size: 0.76rem;
    padding: 0.36rem 1rem;
    background: var(--bg-soft);
    color: var(--ink-soft);
    letter-spacing: 0.1em;
    border-radius: 999px;
  }

  /* ── STORY ── */
  .story-section { padding: var(--space-section) 2rem; }
  .story-inner { max-width: 820px; margin: 0 auto; }
  .story-block {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 2.5rem;
    padding: 2.4rem 0;
    border-bottom: 1px solid var(--hairline);
  }
  .story-block:last-child { border-bottom: none; }
  .story-num {
    font-family: 'Noto Serif TC', serif;
    font-size: 2.6rem;
    font-weight: 600;
    color: var(--brown);
    opacity: 0.6;
    line-height: 1;
  }
  .story-title {
    font-size: 1.15rem;
    letter-spacing: 0.14em;
    margin: 0 0 0.9rem;
  }
  .story-text {
    font-family: 'Noto Serif TC', serif;
    font-size: 0.92rem;
    color: var(--ink-muted);
    font-weight: 300;
    line-height: 2.2;
    letter-spacing: 0.05em;
    margin: 0 0 1.1rem;
  }
  .story-text:last-child { margin-bottom: 0; }

  /* ── BELIEFS ── */
  .beliefs-band {
    padding: var(--space-section) 2rem;
    background: var(--bg-soft);
  }
  .beliefs-inner { max-width: var(--wide-width); margin: 0 auto; }
  .beliefs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
    margin-top: 2rem;
  }
  .belief {
    background: var(--bg-surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    padding: 1.75rem;
  }
  .belief-title {
    font-size: 1.02rem;
    letter-spacing: 0.16em;
    margin: 0 0 0.6rem;
  }
  .belief-desc {
    font-size: 0.83rem;
    color: var(--ink-muted);
    line-height: 2;
    letter-spacing: 0.04em;
    margin: 0;
  }

  /* ── CTA ── */
  .about-cta { padding: var(--space-section) 2rem; text-align: center; }
  .about-cta-inner { max-width: 520px; margin: 0 auto; }
  .about-cta-title { font-size: 1.35rem; letter-spacing: 0.12em; margin: 0 0 0.8rem; }
  .about-cta-desc {
    font-size: 0.87rem;
    color: var(--ink-muted);
    line-height: 2;
    letter-spacing: 0.05em;
    margin: 0 0 2rem;
  }
  .about-cta-btns { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 820px) {
    .about-hero-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    /* 限制外層寬度，印章才會貼在肖像框角落而非螢幕右緣 */
    .about-portrait { max-width: 230px; }
    .story-block { grid-template-columns: 1fr; gap: 0.8rem; padding: 2rem 0; }
    .beliefs-grid { grid-template-columns: 1fr; gap: 1.8rem; }
  }
</style>
