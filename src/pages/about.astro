---
import PageLayout from '../layouts/PageLayout.astro';

const stories = [
  {
    num: '壹',
    title: '我的起點',
    paras: [
      '從小就是個愛看書的孩子，課本以外的書永遠比課本讀得認真。那時候還不知道，這個習慣會成為日後所有事情的底色。',
      '大學時期接觸投資，第一次感受到「讓錢替你工作」的震撼。但真正改變我的，不是某一次獲利，而是在巴菲特的股東信裡讀到的那句話——「時間是優秀企業的朋友，卻是平庸企業的敵人。」從那天起，我開始用長期的眼光看待生命中的每一件事。',
    ],
  },
  {
    num: '貳',
    title: '身體的覺醒',
    paras: [
      '三十歲那年，長期伏案寫作讓身體發出警訊。我走進健身房，原本只想「運動一下」，卻意外發現重量訓練與價值投資竟如此相似——都講究長期堅持、漸進累積，以及對過程的誠實。',
      '肌肉不會說謊，複利也不會。每一次訓練都是一筆存款，存進名為健康的帳戶。',
    ],
  },
  {
    num: '參',
    title: '文字的歸宿',
    paras: [
      '寫作是我把投資的理性與閱讀的感性縫合起來的方式。這個部落格，是我與你分享思考的角落。',
      '願每一個來到這裡的人，都能帶走一點溫暖與啟發。',
    ],
  },
];

const beliefs = [
  { title: '長期主義', desc: '無論投資、健身還是閱讀，時間都是最好的朋友。' },
  { title: '誠實記錄', desc: '只寫真實踐行過的事，絕不濫竽充數。' },
  { title: '深度思考', desc: '慢下來，回到問題的本質。' },
];
---

<PageLayout title="關於我 — 布克小姐｜再富養自己一次人生實驗室" description="認識布克小姐：一個在投資、健身與文學三個領域深耕的創作者">

  <!-- HERO -->
  <section class="about-hero">
    <div class="about-hero-inner">
      <div class="about-portrait">
        <div class="portrait-paper">
          <span class="portrait-char" aria-hidden="true">布</span>
          <span class="portrait-caption">作者・布克小姐</span>
        </div>
        <span class="seal about-seal" aria-hidden="true">布克</span>
      </div>
      <div class="about-hero-text">
        <span class="label-en">About the Author</span>
        <h1 class="about-hero-title">布克小姐——<br />用文字丈量生命的寬度</h1>
        <p class="about-hero-desc">
          投資人、健身愛好者、書蟲。相信複利不只發生在財富裡，也發生在每一天微小而持續的成長中。
        </p>
        <div class="about-tags">
          <span class="about-tag">價值投資</span>
          <span class="about-tag">肌力訓練</span>
          <span class="about-tag">文學閱讀</span>
          <span class="about-tag">深度寫作</span>
          <span class="about-tag">思維框架</span>
        </div>
      </div>
    </div>
  </section>

  <!-- STORY -->
  <section class="story-section">
    <div class="story-inner">
      <span class="label-en">My Story</span>
      <h2 class="section-title">三段故事</h2>
      {stories.map(s => (
        <div class="story-block">
          <div class="story-side">
            <span class="story-num">{s.num}</span>
          </div>
          <div class="story-main">
            <h3 class="story-title">{s.title}</h3>
            {s.paras.map(p => <p class="story-text">{p}</p>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- BELIEFS -->
  <section class="beliefs-band">
    <div class="beliefs-inner">
      <span class="label-en">Beliefs</span>
      <h2 class="section-title">三個信念</h2>
      <div class="beliefs-grid">
        {beliefs.map(b => (
          <div class="belief">
            <h3 class="belief-title">{b.title}</h3>
            <p class="belief-desc">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="about-cta">
    <div class="about-cta-inner">
      <h2 class="about-cta-title">想進一步交流嗎？</h2>
      <p class="about-cta-desc">無論是合作邀約還是讀者交流，都歡迎寫信給我。</p>
      <div class="about-cta-btns">
        <a href="/contact" class="btn-primary">與我聯絡</a>
        <a href="/blog" class="btn-secondary">閱讀文章</a>
      </div>
    </div>
  </section>

</PageLayout>

<style>
  /* ── HERO ── */
  .about-hero {
    padding: 5rem 2rem 4rem;
    border-bottom: 1px solid var(--hairline);
  }
  .about-hero-inner {
    max-width: 1060px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 270px 1fr;
    gap: 4.5rem;
    align-items: center;
  }
  .about-portrait { position: relative; }
  .portrait-paper {
    aspect-ratio: 3 / 4;
    border: 1px solid var(--hairline-strong);
    background: var(--paper-blush);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.6rem;
    padding: 1.5rem;
    position: relative;
  }
  .portrait-paper::before {
    content: '';
    position: absolute;
    inset: 8px;
    border: 1px solid var(--hairline);
    pointer-events: none;
  }
  .portrait-char {
    font-family: 'Noto Serif TC', serif;
    font-size: 6rem;
    font-weight: 600;
    color: var(--brown);
    opacity: 0.5;
    line-height: 1;
  }
  .portrait-caption {
    font-size: 0.72rem;
    color: var(--ink-muted);
    letter-spacing: 0.3em;
  }
  .about-seal {
    position: absolute;
    right: -10px;
    bottom: -12px;
    font-size: 0.92rem;
  }
  .about-hero-title {
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    letter-spacing: 0.1em;
    line-height: 1.6;
    margin: 0.4rem 0 1.2rem;
  }
  .about-hero-desc {
    font-family: 'Noto Serif TC', serif;
    font-size: 0.96rem;
    color: var(--ink-muted);
    font-weight: 300;
    line-height: 2.15;
    letter-spacing: 0.06em;
    margin: 0 0 1.8rem;
    max-width: 520px;
  }
  .about-tags { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .about-tag {
    font-size: 0.74rem;
    padding: 0.32rem 0.9rem;
    border: 1px solid var(--hairline-strong);
    color: var(--ink-soft);
    letter-spacing: 0.14em;
    border-radius: 2px;
  }

  /* ── STORY ── */
  .story-section { padding: 4.5rem 2rem; }
  .story-inner { max-width: 820px; margin: 0 auto; }
  .story-block {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 2.5rem;
    padding: 2.4rem 0;
    border-bottom: 1px solid var(--hairline);
  }
  .story-block:last-child { border-bottom: none; }
  .story-num {
    font-family: 'Noto Serif TC', serif;
    font-size: 2.6rem;
    font-weight: 600;
    color: var(--brown);
    opacity: 0.6;
    line-height: 1;
  }
  .story-title {
    font-size: 1.15rem;
    letter-spacing: 0.14em;
    margin: 0 0 0.9rem;
  }
  .story-text {
    font-family: 'Noto Serif TC', serif;
    font-size: 0.92rem;
    color: var(--ink-muted);
    font-weight: 300;
    line-height: 2.2;
    letter-spacing: 0.05em;
    margin: 0 0 1.1rem;
  }
  .story-text:last-child { margin-bottom: 0; }

  /* ── BELIEFS ── */
  .beliefs-band {
    padding: 4.5rem 2rem;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0px,
        transparent 9px,
        rgba(90, 72, 50, 0.035) 9px,
        rgba(90, 72, 50, 0.035) 10px
      ),
      var(--paper-warm);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .beliefs-inner { max-width: 1060px; margin: 0 auto; }
  .beliefs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
    margin-top: 2rem;
  }
  .belief {
    border-top: 1px solid var(--hairline-strong);
    padding-top: 1.3rem;
  }
  .belief-title {
    font-size: 1.02rem;
    letter-spacing: 0.16em;
    margin: 0 0 0.6rem;
  }
  .belief-desc {
    font-size: 0.83rem;
    color: var(--ink-muted);
    line-height: 2;
    letter-spacing: 0.04em;
    margin: 0;
  }

  /* ── CTA ── */
  .about-cta { padding: 5rem 2rem; text-align: center; }
  .about-cta-inner { max-width: 520px; margin: 0 auto; }
  .about-cta-title { font-size: 1.35rem; letter-spacing: 0.12em; margin: 0 0 0.8rem; }
  .about-cta-desc {
    font-size: 0.87rem;
    color: var(--ink-muted);
    line-height: 2;
    letter-spacing: 0.05em;
    margin: 0 0 2rem;
  }
  .about-cta-btns { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 820px) {
    .about-hero-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    /* 限制外層寬度，印章才會貼在肖像框角落而非螢幕右緣 */
    .about-portrait { max-width: 230px; }
    .story-block { grid-template-columns: 1fr; gap: 0.8rem; padding: 2rem 0; }
    .beliefs-grid { grid-template-columns: 1fr; gap: 1.8rem; }
  }
</style>
