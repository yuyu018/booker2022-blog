---
import PageLayout from '../layouts/PageLayout.astro';

const stories = [
  {
    num: '壹',
    title: '從月光族開始',
    paras: [
      '剛開始上班的時候，我是標準的月光族。三十歲才真正開始賺錢，第一次有了自己的薪水，那種「終於可以自己決定錢要怎麼花」的感覺太強烈，一個包包就能花掉一、兩個月的薪水。',
      '2020 年開始投資理財，讀了《致富心態》，才慢慢明白財富自由的目的不是追一個數字，而是買回自己的時間。現在我用指數型 ETF 長期投資，讓時間站在我這邊。',
    ],
  },
  {
    num: '貳',
    title: '在身體裡找回節奏',
    paras: [
      '我是先天僵硬的「鋼鐵人」，卻在連續 20 週的師資班之後，拿到了瑜珈師資證照——那是我 50 個夢想清單裡的其中一個。',
      '每週六早上的一對一重訓，加上跟著營養師調整飲食，讓我發現改變的從來不只是體態，而是整個生活型態。',
    ],
  },
  {
    num: '參',
    title: '和自己好好對話',
    paras: [
      '2026 年春天，我開始和 life coach 對話，也因此養成寫日記的習慣。從一篇篇充滿怨念的流水帳，慢慢寫成能看見自己的紀錄。',
      '我還在學日文，也常常中斷。但就像開車一樣，方向盤偏了，就導正回來。這個部落格就是我的人生實驗室：一邊生活、一邊思考，也一邊尋找答案。',
    ],
  },
];

const beliefs = [
  { title: '把選擇留給未來的自己', desc: '存錢不是把錢鎖起來，而是讓人生出現不同選項時，我有能力選擇。' },
  { title: '讓每天都有值得期待的事', desc: '一堂課、一本書、一頓好吃的飯，小小的期待都是生活在發光的證明。' },
  { title: '一邊走，一邊修正', desc: '人生不需要一次就找到正確答案，只要願意往前走，就會慢慢知道什麼適合自己。' },
];
---

<PageLayout title="關於我 — 布克小姐｜再富養一次" description="認識布克小姐：一個普通上班族，在金錢、生活、閱讀與自我成長之間，替自己做一場人生實驗。">

  <!-- HERO -->
  <section class="about-hero">
    <div class="about-hero-inner">
      <div class="about-portrait">
        <div class="portrait-paper">
          <img class="portrait-img" src="/booker-avatar.png" alt="布克小姐" width="256" height="256" decoding="async" />
          <span class="portrait-caption">作者・布克小姐</span>
        </div>
        <span class="seal about-seal" aria-hidden="true">布克</span>
      </div>
      <div class="about-hero-text">
        <span class="label-en">About the Author</span>
        <h1 class="about-hero-title">布克小姐——<br />再富養自己一次</h1>
        <p class="about-hero-desc">
          上班族、指數投資人、瑜珈師資，也是還在學日文的學生。相信富足不只是存款數字，而是用每一天，慢慢把人生過成自己喜歡的樣子。
        </p>
        <div class="about-tags">
          <span class="about-tag">指數投資</span>
          <span class="about-tag">瑜珈師資</span>
          <span class="about-tag">一對一重訓</span>
          <span class="about-tag">寫日記</span>
          <span class="about-tag">學日文</span>
          <span class="about-tag">滑雪</span>
        </div>
      </div>
    </div>
  </section>

  <!-- STORY -->
  <section class="story-section">
    <div class="story-inner">
      <span class="label-en">My Story</span>
      <h2 class="section-title">三段故事</h2>
      {stories.map(s => (
        <div class="story-block">
          <div class="story-side">
            <span class="story-num">{s.num}</span>
          </div>
          <div class="story-main">
            <h3 class="story-title">{s.title}</h3>
            {s.paras.map(p => <p class="story-text">{p}</p>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- BELIEFS -->
  <section class="beliefs-band">
    <div class="beliefs-inner">
      <span class="label-en">Beliefs</span>
      <h2 class="section-title">三個信念</h2>
      <div class="beliefs-grid">
        {beliefs.map(b => (
          <div class="belief">
            <h3 class="belief-title">{b.title}</h3>
            <p class="belief-desc">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="about-cta">
    <div class="about-cta-inner">
      <h2 class="about-cta-title">想進一步交流嗎？</h2>
      <p class="about-cta-desc">無論是合作邀約還是讀者交流，都歡迎寫信給我。</p>
      <div class="about-cta-btns">
        <a href="/contact" class="btn-primary">與我聯絡</a>
        <a href="/blog" class="btn-secondary">閱讀文章</a>
      </div>
    </div>
  </section>

</PageLayout>

<style>
  /* ── HERO ── */
  .about-hero {
    padding: 5rem 2rem 4rem;
    border-bottom: 1px solid var(--hairline);
  }
  .about-hero-inner {
    max-width: 1060px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 270px 1fr;
    gap: 4.5rem;
    align-items: center;
  }
  .about-portrait { position: relative; }
  .portrait-paper {
    aspect-ratio: 3 / 4;
    border: 1px solid var(--hairline-strong);
    background: var(--paper-blush);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.6rem;
    padding: 1.5rem;
    position: relative;
  }
  .portrait-paper::before {
    content: '';
    position: absolute;
    inset: 8px;
    border: 1px solid var(--hairline);
    pointer-events: none;
  }
  .portrait-img {
    width: 74%;
    height: auto;
    display: block;
  }
  .portrait-caption {
    font-size: 0.72rem;
    color: var(--ink-muted);
    letter-spacing: 0.3em;
  }
  .about-seal {
    position: absolute;
    right: -10px;
    bottom: -12px;
    font-size: 0.92rem;
  }
  .about-hero-title {
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    letter-spacing: 0.1em;
    line-height: 1.6;
    margin: 0.4rem 0 1.2rem;
  }
  .about-hero-desc {
    font-family: 'Noto Serif TC', serif;
    font-size: 0.96rem;
    color: var(--ink-muted);
    font-weight: 300;
    line-height: 2.15;
    letter-spacing: 0.06em;
    margin: 0 0 1.8rem;
    max-width: 520px;
  }
  .about-tags { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .about-tag {
    font-size: 0.74rem;
    padding: 0.32rem 0.9rem;
    border: 1px solid var(--hairline-strong);
    color: var(--ink-soft);
    letter-spacing: 0.14em;
    border-radius: 2px;
  }

  /* ── STORY ── */
  .story-section { padding: 4.5rem 2rem; }
  .story-inner { max-width: 820px; margin: 0 auto; }
  .story-block {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 2.5rem;
    padding: 2.4rem 0;
    border-bottom: 1px solid var(--hairline);
  }
  .story-block:last-child { border-bottom: none; }
  .story-num {
    font-family: 'Noto Serif TC', serif;
    font-size: 2.6rem;
    font-weight: 600;
    color: var(--brown);
    opacity: 0.6;
    line-height: 1;
  }
  .story-title {
    font-size: 1.15rem;
    letter-spacing: 0.14em;
    margin: 0 0 0.9rem;
  }
  .story-text {
    font-family: 'Noto Serif TC', serif;
    font-size: 0.92rem;
    color: var(--ink-muted);
    font-weight: 300;
    line-height: 2.2;
    letter-spacing: 0.05em;
    margin: 0 0 1.1rem;
  }
  .story-text:last-child { margin-bottom: 0; }

  /* ── BELIEFS ── */
  .beliefs-band {
    padding: 4.5rem 2rem;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0px,
        transparent 9px,
        rgba(90, 72, 50, 0.035) 9px,
        rgba(90, 72, 50, 0.035) 10px
      ),
      var(--paper-warm);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .beliefs-inner { max-width: 1060px; margin: 0 auto; }
  .beliefs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
    margin-top: 2rem;
  }
  .belief {
    border-top: 1px solid var(--hairline-strong);
    padding-top: 1.3rem;
  }
  .belief-title {
    font-size: 1.02rem;
    letter-spacing: 0.16em;
    margin: 0 0 0.6rem;
  }
  .belief-desc {
    font-size: 0.83rem;
    color: var(--ink-muted);
    line-height: 2;
    letter-spacing: 0.04em;
    margin: 0;
  }

  /* ── CTA ── */
  .about-cta { padding: 5rem 2rem; text-align: center; }
  .about-cta-inner { max-width: 520px; margin: 0 auto; }
  .about-cta-title { font-size: 1.35rem; letter-spacing: 0.12em; margin: 0 0 0.8rem; }
  .about-cta-desc {
    font-size: 0.87rem;
    color: var(--ink-muted);
    line-height: 2;
    letter-spacing: 0.05em;
    margin: 0 0 2rem;
  }
  .about-cta-btns { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 820px) {
    .about-hero-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    /* 限制外層寬度，印章才會貼在肖像框角落而非螢幕右緣 */
    .about-portrait { max-width: 230px; }
    .story-block { grid-template-columns: 1fr; gap: 0.8rem; padding: 2rem 0; }
    .beliefs-grid { grid-template-columns: 1fr; gap: 1.8rem; }
  }
</style>
