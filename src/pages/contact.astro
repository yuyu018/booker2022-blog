---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import { contactText as t, numeral } from '../lib/site';
---

<PageLayout title={t.seoTitle} description={t.seoDescription}>

  <PageHero label={t.heroLabelEn} labelZh={t.heroLabelZh} title={t.heroTitle} titleAccent={t.heroTitleAccent}>
    {t.heroDesc}
  </PageHero>

  <section class="contact-section">
    <div class="contact-inner">

      <!-- 左：聯絡方式 -->
      <div class="contact-info">
        {t.channels.map((c, i) => (
          <div class="channel">
            <span class="channel-num">{numeral(i)}</span>
            <div>
              <h3 class="channel-title">{c.title}</h3>
              <p class="channel-desc">{c.desc}</p>
              <a href={c.linkHref} class="channel-link" target={c.linkHref.startsWith('http') ? '_blank' : undefined} rel={c.linkHref.startsWith('http') ? 'noopener' : undefined}>{c.linkText}</a>
            </div>
          </div>
        ))}
        <p class="contact-note">{t.note}</p>
      </div>

      <!-- 右：表單 -->
      <div class="contact-form-wrap">
        <span class="label-en">{t.formLabelEn}</span>
        <h2 class="form-title">{t.formTitle}</h2>

        <form class="contact-form" action={t.formAction} method="POST">
          <div class="form-row">
            <div class="form-group">
              <label for="name" class="form-label">{t.labelName}</label>
              <input type="text" id="name" name="name" class="form-input" placeholder={t.placeholderName} required />
            </div>
            <div class="form-group">
              <label for="email" class="form-label">{t.labelEmail}</label>
              <input type="email" id="email" name="email" class="form-input" placeholder={t.placeholderEmail} required />
            </div>
          </div>

          <div class="form-group">
            <label for="subject" class="form-label">{t.labelSubject}</label>
            <select id="subject" name="subject" class="form-input form-select">
              {/* 第一項是提示文字，選了不會送出內容 */}
              {t.subjectOptions.map((opt, i) => (
                <option value={i === 0 ? '' : opt}>{opt}</option>
              ))}
            </select>
          </div>

          <div class="form-group">
            <label for="message" class="form-label">{t.labelMessage}</label>
            <textarea id="message" name="message" class="form-input form-textarea" rows="6" placeholder={t.placeholderMessage} required></textarea>
          </div>

          <button type="submit" class="btn-primary form-submit">{t.submitLabel}</button>
        </form>
      </div>

    </div>
  </section>

</PageLayout>

<style>
  .contact-section { padding: calc(var(--space-section) * 0.6) 2rem var(--space-section); }
  .contact-inner {
    max-width: var(--wide-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 5rem;
    align-items: start;
  }

  /* ── 聯絡方式 ── */
  .channel {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 1.4rem;
    padding: 1.8rem 0;
    border-bottom: 1px solid var(--hairline);
  }
  .channel:first-child { padding-top: 0.5rem; }
  .channel-num {
    font-family: 'Noto Serif TC', serif;
    font-size: 1.7rem;
    font-weight: 600;
    color: var(--brown);
    opacity: 0.6;
    line-height: 1.3;
  }
  .channel-title {
    font-size: 1rem;
    letter-spacing: 0.14em;
    margin: 0 0 0.45rem;
  }
  .channel-desc {
    font-size: 0.82rem;
    color: var(--ink-muted);
    line-height: 1.95;
    letter-spacing: 0.04em;
    margin: 0 0 0.55rem;
  }
  .channel-link {
    font-family: 'Lora', serif;
    font-size: 0.84rem;
    color: var(--brown);
    letter-spacing: 0.05em;
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-strong);
    padding-bottom: 0.15rem;
    transition: color 0.2s, border-color 0.2s;
  }
  .channel-link:hover { color: var(--brown-deep); border-bottom-color: var(--brown); }
  .contact-note {
    font-size: 0.78rem;
    color: var(--ink-muted);
    line-height: 2;
    letter-spacing: 0.05em;
    margin: 1.6rem 0 0;
    padding-left: 1rem;
    border-left: 2px solid var(--hairline-strong);
  }

  /* ── 表單 ── */
  .form-title {
    font-size: 1.3rem;
    letter-spacing: 0.12em;
    margin: 0.3rem 0 2rem;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  .form-group { margin-bottom: 1.8rem; }
  .form-label {
    display: block;
    font-size: 0.76rem;
    color: var(--ink-soft);
    letter-spacing: 0.2em;
    margin-bottom: 0.5rem;
  }
  .form-input {
    width: 100%;
    padding: 0.55rem 0.1rem;
    border: none;
    border-bottom: 1px solid var(--hairline-strong);
    background: transparent;
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 0.9rem;
    color: var(--ink);
    letter-spacing: 0.05em;
    outline: none;
    border-radius: 0;
    transition: border-color 0.25s;
  }
  .form-input:focus { border-bottom-color: var(--brown); }
  .form-input::placeholder { color: rgba(138, 121, 98, 0.5); }
  .form-select {
    appearance: none;
    cursor: pointer;
    color: var(--ink-soft);
  }
  .form-textarea {
    resize: vertical;
    line-height: 1.9;
    border: 1px solid var(--hairline-strong);
    padding: 0.8rem 1rem;
    margin-top: 0.2rem;
  }
  .form-textarea:focus { border-color: var(--brown); }
  .form-submit {
    cursor: pointer;
    font-family: 'Noto Sans TC', sans-serif;
    margin-top: 0.4rem;
  }

  @media (max-width: 820px) {
    .contact-inner { grid-template-columns: 1fr; gap: 3rem; }
    .form-row { grid-template-columns: 1fr; gap: 0; }
    /* iOS Safari 對小於 16px 的輸入框會在聚焦時自動放大畫面 */
    .form-input { font-size: 16px; }
    /* 擴大觸控範圍到約 44px，不改變外觀 */
    .channel-link { position: relative; }
    .channel-link::after { content: ''; position: absolute; inset: -12px -8px; }
  }
</style>
