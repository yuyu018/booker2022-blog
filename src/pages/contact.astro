---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';

const channels = [
  {
    num: '壹',
    title: '電子郵件',
    desc: '最直接的聯絡方式，通常在 2–3 個工作天內回覆。',
    link: { href: 'mailto:hello@example.com', text: 'hello@example.com' },
  },
  {
    num: '貳',
    title: '合作邀約',
    desc: '演講、課程、文章合作或品牌業配，歡迎附上相關資訊。',
    link: { href: 'mailto:collab@example.com', text: 'collab@example.com' },
  },
  {
    num: '參',
    title: '社群媒體',
    desc: '日常思考片段與閱讀紀錄，歡迎追蹤互動。',
    link: { href: 'https://twitter.com/', text: '@booker_writes' },
  },
];
---

<PageLayout title="聯絡資訊 — 布克小姐｜再富養自己一次人生實驗室" description="與布克小姐聯絡，歡迎合作邀約、讀者交流或任何想法分享">

  <PageHero label="Get in Touch" labelZh="聯絡資訊" titleHtml="讓我們開始<em>對話</em>">
    無論是合作邀約、讀者回饋，還是單純想聊聊書與投資，都歡迎寫信給我。每一封信我都會親自閱讀。
  </PageHero>

  <section class="contact-section">
    <div class="contact-inner">

      <!-- 左：聯絡方式 -->
      <div class="contact-info">
        {channels.map(c => (
          <div class="channel">
            <span class="channel-num">{c.num}</span>
            <div>
              <h3 class="channel-title">{c.title}</h3>
              <p class="channel-desc">{c.desc}</p>
              <a href={c.link.href} class="channel-link" target={c.link.href.startsWith('http') ? '_blank' : undefined} rel={c.link.href.startsWith('http') ? 'noopener' : undefined}>{c.link.text}</a>
            </div>
          </div>
        ))}
        <p class="contact-note">若是讀者問題或文章回饋，也可以直接在文章底部留言，我同樣會看到。</p>
      </div>

      <!-- 右：表單 -->
      <div class="contact-form-wrap">
        <span class="label-en">Send a Message</span>
        <h2 class="form-title">傳送訊息</h2>

        <form class="contact-form" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
          <div class="form-row">
            <div class="form-group">
              <label for="name" class="form-label">姓名</label>
              <input type="text" id="name" name="name" class="form-input" placeholder="你的名字" required />
            </div>
            <div class="form-group">
              <label for="email" class="form-label">電子郵件</label>
              <input type="email" id="email" name="email" class="form-input" placeholder="your@email.com" required />
            </div>
          </div>

          <div class="form-group">
            <label for="subject" class="form-label">主旨</label>
            <select id="subject" name="subject" class="form-input form-select">
              <option value="">請選擇聯絡類型</option>
              <option value="reader">讀者回饋</option>
              <option value="collab">合作邀約</option>
              <option value="money">金錢話題交流</option>
              <option value="life">生活話題交流</option>
              <option value="reading">閱讀話題交流</option>
              <option value="growth">自我成長話題交流</option>
              <option value="other">其他</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message" class="form-label">訊息內容</label>
            <textarea id="message" name="message" class="form-input form-textarea" rows="6" placeholder="請輸入你想說的話……" required></textarea>
          </div>

          <button type="submit" class="btn-primary form-submit">送出訊息</button>
        </form>
      </div>

    </div>
  </section>

</PageLayout>

<style>
  .contact-section { padding: 3.5rem 2rem 5rem; }
  .contact-inner {
    max-width: 1060px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 5rem;
    align-items: start;
  }

  /* ── 聯絡方式 ── */
  .channel {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 1.4rem;
    padding: 1.8rem 0;
    border-bottom: 1px solid var(--hairline);
  }
  .channel:first-child { padding-top: 0.5rem; }
  .channel-num {
    font-family: 'Noto Serif TC', serif;
    font-size: 1.7rem;
    font-weight: 600;
    color: var(--brown);
    opacity: 0.6;
    line-height: 1.3;
  }
  .channel-title {
    font-size: 1rem;
    letter-spacing: 0.14em;
    margin: 0 0 0.45rem;
  }
  .channel-desc {
    font-size: 0.82rem;
    color: var(--ink-muted);
    line-height: 1.95;
    letter-spacing: 0.04em;
    margin: 0 0 0.55rem;
  }
  .channel-link {
    font-family: 'Lora', serif;
    font-size: 0.84rem;
    color: var(--brown);
    letter-spacing: 0.05em;
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-strong);
    padding-bottom: 0.15rem;
    transition: color 0.2s, border-color 0.2s;
  }
  .channel-link:hover { color: var(--brown-deep); border-bottom-color: var(--brown); }
  .contact-note {
    font-size: 0.78rem;
    color: var(--ink-muted);
    line-height: 2;
    letter-spacing: 0.05em;
    margin: 1.6rem 0 0;
    padding-left: 1rem;
    border-left: 2px solid var(--hairline-strong);
  }

  /* ── 表單 ── */
  .form-title {
    font-size: 1.3rem;
    letter-spacing: 0.12em;
    margin: 0.3rem 0 2rem;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  .form-group { margin-bottom: 1.8rem; }
  .form-label {
    display: block;
    font-size: 0.76rem;
    color: var(--ink-soft);
    letter-spacing: 0.2em;
    margin-bottom: 0.5rem;
  }
  .form-input {
    width: 100%;
    padding: 0.55rem 0.1rem;
    border: none;
    border-bottom: 1px solid var(--hairline-strong);
    background: transparent;
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 0.9rem;
    color: var(--ink);
    letter-spacing: 0.05em;
    outline: none;
    border-radius: 0;
    transition: border-color 0.25s;
  }
  .form-input:focus { border-bottom-color: var(--brown); }
  .form-input::placeholder { color: rgba(138, 121, 98, 0.5); }
  .form-select {
    appearance: none;
    cursor: pointer;
    color: var(--ink-soft);
  }
  .form-textarea {
    resize: vertical;
    line-height: 1.9;
    border: 1px solid var(--hairline-strong);
    padding: 0.8rem 1rem;
    margin-top: 0.2rem;
  }
  .form-textarea:focus { border-color: var(--brown); }
  .form-submit {
    cursor: pointer;
    font-family: 'Noto Sans TC', sans-serif;
    margin-top: 0.4rem;
  }

  @media (max-width: 820px) {
    .contact-inner { grid-template-columns: 1fr; gap: 3rem; }
    .form-row { grid-template-columns: 1fr; gap: 0; }
    /* iOS Safari 對小於 16px 的輸入框會在聚焦時自動放大畫面 */
    .form-input { font-size: 16px; }
    /* 擴大觸控範圍到約 44px，不改變外觀 */
    .channel-link { position: relative; }
    .channel-link::after { content: ''; position: absolute; inset: -12px -8px; }
  }
</style>
