---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { articles, categoryMeta } from '../../data/articles';

const groups = (['investment', 'fitness', 'literature'] as const).map(slug => ({
  slug,
  meta: categoryMeta[slug],
  posts: articles.filter(a => a.categorySlug === slug),
}));
---

<PageLayout title="所有文章 — 布克小姐的文學天地" description="投資策略、科學健身與知識文學的所有文章總覽">

  <PageHero label="All Writings" labelZh="文章總覽" titleHtml="所有文章">
    從財富、身體到精神，每個面向都值得細細探索。用文字留住思考的痕跡。
  </PageHero>

  <section class="archive-section">
    <div class="section-inner">
      {groups.map((g, gi) => (
        <div class="archive-group">
          <div class="archive-group-head">
            <div>
              <span class="label-en">{g.meta.labelEn}</span>
              <h2 class="archive-group-title">
                <span class="archive-group-num">{['壹', '貳', '參'][gi]}</span>
                {g.meta.title}
              </h2>
            </div>
            <a href={`/blog/${g.slug}`} class="archive-group-link">進入主題 →</a>
          </div>
          {g.posts.slice(0, 3).map((a, i) => (
            <a href={`/blog/${g.slug}`} class="writing-row">
              <span class="writing-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="writing-title">{a.title}</h3>
                <p class="writing-excerpt">{a.excerpt}</p>
              </div>
              <div class="writing-meta">
                <span>{a.readTime}</span><span class="m-dot">・</span>
                <span>{a.date}</span>
              </div>
            </a>
          ))}
        </div>
      ))}
    </div>
  </section>

</PageLayout>

<style>
  .archive-section { padding: 3.5rem 2rem 5rem; }
  .archive-group { margin-bottom: 4rem; }
  .archive-group:last-child { margin-bottom: 0; }
  .archive-group-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.6rem;
  }
  .archive-group-title {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    font-size: 1.3rem;
    letter-spacing: 0.12em;
    margin: 0;
  }
  .archive-group-num {
    font-size: 1.7rem;
    color: var(--brown);
  }
  .archive-group-link {
    font-size: 0.78rem;
    color: var(--brown);
    letter-spacing: 0.12em;
    text-decoration: none;
    white-space: nowrap;
    padding-bottom: 0.3rem;
  }
  .archive-group-link:hover { color: var(--brown-deep); }
</style>
