---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { CATEGORIES, categoryMeta, getPosts, monthLabel, postUrl, readTime } from '../../lib/posts';

const PER_GROUP = 5;
const posts = await getPosts();

const groups = CATEGORIES.map(slug => ({
  slug,
  meta: categoryMeta[slug],
  posts: posts.filter(p => p.data.category === slug),
}));
---

<PageLayout title="所有文章 — 布克小姐｜再富養一次" description="金錢、生活、閱讀與自我成長的所有文章總覽">

  <PageHero label="All Writings" labelZh="文章總覽" titleHtml="所有文章">
    從金錢、生活、閱讀到自我成長，共 {posts.length} 篇文章。用文字留住思考的痕跡。
  </PageHero>

  <section class="archive-section">
    <div class="section-inner">
      {groups.map(g => (
        <div class="archive-group">
          <div class="archive-group-head">
            <div>
              <span class="label-en">{g.meta.labelEn}</span>
              <h2 class="archive-group-title">
                <span class="archive-group-num">{g.meta.num}</span>
                {g.meta.title}
              </h2>
            </div>
            <a href={`/blog/${g.slug}`} class="archive-group-link">全部 {g.posts.length} 篇 →</a>
          </div>
          {g.posts.slice(0, PER_GROUP).map((p, i) => (
            <a href={postUrl(p)} class="writing-row">
              <span class="writing-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="writing-title">{p.data.title}</h3>
                <p class="writing-excerpt">{p.data.description}</p>
              </div>
              <div class="writing-meta">
                <span>{readTime(p)}</span><span class="m-dot">・</span>
                <span>{monthLabel(p.data.pubDate)}</span>
              </div>
            </a>
          ))}
        </div>
      ))}
    </div>
  </section>

</PageLayout>

<style>
  .archive-section { padding: 3.5rem 2rem 5rem; }
  .archive-group { margin-bottom: 4rem; }
  .archive-group:last-child { margin-bottom: 0; }
  .archive-group-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.6rem;
  }
  .archive-group-title {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    font-size: 1.3rem;
    letter-spacing: 0.12em;
    margin: 0;
  }
  .archive-group-num {
    font-size: 1.7rem;
    color: var(--brown);
  }
  .archive-group-link {
    font-size: 0.78rem;
    color: var(--brown);
    letter-spacing: 0.12em;
    text-decoration: none;
    white-space: nowrap;
    padding-bottom: 0.3rem;
  }
  .archive-group-link:hover { color: var(--brown-deep); }
</style>
