---
import PageLayout from '../layouts/PageLayout.astro';
import { CATEGORIES, categoryMeta, getPosts, monthLabel, postUrl, readTime, type Post } from '../lib/posts';

const posts = await getPosts();

/* 首頁精選：每個分類取最新一篇 */
const featured = CATEGORIES
  .map(c => posts.find(p => p.data.category === c))
  .filter((p): p is Post => p !== undefined);

const pillars = CATEGORIES.map(c => ({
  num: categoryMeta[c].num,
  title: categoryMeta[c].short,
  desc: categoryMeta[c].pillar,
  href: `/blog/${c}`,
}));
---

<PageLayout title="布克小姐｜再富養自己一次人生實驗室 — 金錢・生活・閱讀・成長" description="關於金錢、富足、生活、閱讀、成長與人生，一邊生活、一邊思考，也一邊尋找答案。">

  <!-- ══════════════════════════════════
       HERO：直排標題 × 印章
  ══════════════════════════════════ -->
  <section id="s-hero" class="hero">
    <div class="hero-inner">

      <div class="hero-left">
        <p class="hero-side" aria-hidden="true">金錢・生活・閱讀・成長</p>
        <div class="hero-vwrap">
          <h1 class="hero-vtitle">
            <span class="vcol">用文字耕耘</span>
            <span class="vcol vcol-2">生命的質地</span>
          </h1>
          <span class="seal hero-seal" aria-hidden="true">布克</span>
        </div>
      </div>

      <div class="hero-right">
        <p class="label-en">Money · Life · Reading · Growth</p>
        <h2 class="hero-name"><span class="ph">布克小姐｜</span><span class="ph">再富養自己一次人生實驗室</span></h2>
        <p class="hero-desc">
          <span class="ph">我們如何度過每一天，</span><span class="ph">當然也就是我們如何度過一生。</span><br />
          <span class="ph">關於金錢、富足、生活、</span><span class="ph">閱讀、成長與人生，</span><br />
          <span class="ph">一邊生活、一邊思考，</span><span class="ph">也一邊尋找答案。</span><br />
          <span class="ph">慢慢把人生過成自己喜歡的樣子。🌱</span>
        </p>
        <div class="hero-cta">
          <a href="/blog" class="btn-primary">開始閱讀</a>
          <a href="/about" class="btn-secondary">認識作者</a>
        </div>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-num">10+</span>
            <span class="stat-label">年投資經驗</span>
          </div>
          <div class="stat">
            <span class="stat-num">300+</span>
            <span class="stat-label">本閱讀書目</span>
          </div>
          <div class="stat">
            <span class="stat-num">{posts.length}</span>
            <span class="stat-label">篇原創文章</span>
          </div>
        </div>
      </div>

    </div>
    <div class="hero-texture" aria-hidden="true"></div>
  </section>

  <!-- ══════════════════════════════════
       內容支柱 FOUR PILLARS
  ══════════════════════════════════ -->
  <section id="s-pillars" class="pillars-section">
    <div class="section-inner">
      <span class="label-en">Four Pillars</span>
      <h2 class="section-title">內容支柱</h2>
      <div class="pillars-grid">
        {pillars.map(p => (
          <a href={p.href} class="pillar">
            <div class="pillar-head">
              <span class="pillar-num">{p.num}</span>
              <h3 class="pillar-title">{p.title}</h3>
            </div>
            <p class="pillar-desc">{p.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════
       精選文章 SELECTED WRITINGS
  ══════════════════════════════════ -->
  <section id="s-writings" class="writings-section">
    <div class="section-inner">
      <div class="writings-head">
        <div>
          <span class="label-en">Selected Writings</span>
          <h2 class="section-title">精選文章</h2>
        </div>
        <a href="/blog" class="writings-all">查看所有文章 →</a>
      </div>
      <div class="writings-list">
        {featured.map((p, i) => (
          <a href={postUrl(p)} class="writing-row scroll-reveal" style={`--delay:${i * 0.12}s`}>
            <span class="writing-num">0{i + 1}</span>
            <div>
              <h3 class="writing-title">{p.data.title}</h3>
              <p class="writing-excerpt">{p.data.description}</p>
            </div>
            <div class="writing-meta">
              {p.data.category && <><span class="m-cat">{categoryMeta[p.data.category].short}</span><span class="m-dot">・</span></>}
              <span>{readTime(p)}</span><span class="m-dot">・</span>
              <span>{monthLabel(p.data.pubDate)}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════
       摘句 QUOTE
  ══════════════════════════════════ -->
  <section id="s-quote" class="quote-band">
    <div class="quote-inner">
      <span class="quote-label scroll-reveal" style="--delay:0s">摘　句</span>
      <blockquote class="quote-text scroll-reveal" style="--delay:0.15s">
        閱讀是一種孤獨的行動，卻也是最深刻的相遇——<br />
        你在每一個句子裡，都能找到另一個更完整的自己。
      </blockquote>
      <p class="quote-author scroll-reveal" style="--delay:0.3s">
        — 布克小姐 <span class="seal quote-seal" aria-hidden="true">布克</span>
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════
       ABOUT
  ══════════════════════════════════ -->
  <section id="s-about" class="about-section">
    <div class="about-inner">
      <div class="about-portrait">
        <div class="portrait-paper">
          <span class="portrait-char" aria-hidden="true">布</span>
          <span class="portrait-caption">作者・布克小姐</span>
        </div>
      </div>
      <div class="about-content">
        <span class="label-en">About</span>
        <h2 class="section-title">一個愛書、愛運動<br />也愛思考財富的人</h2>
        <p class="about-intro">
          我相信「閱讀是最低成本的自我投資」。在金錢、生活、閱讀與自我成長之間持續探索，尋找它們共同的內核——長期主義，以及對複利思維的深刻信仰。
        </p>
        <div class="about-tags">
          <span class="about-tag">金錢觀念</span>
          <span class="about-tag">生活日記</span>
          <span class="about-tag">閱讀筆記</span>
          <span class="about-tag">自我成長</span>
        </div>
        <a href="/about" class="btn-primary">了解更多</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════
       NEWSLETTER
  ══════════════════════════════════ -->
  <section id="s-newsletter" class="newsletter-section">
    <div class="newsletter-inner">
      <h2 class="newsletter-title">訂閱布克小姐電子報</h2>
      <p class="newsletter-desc">每兩週一封，精選最值得閱讀的文章與思考片段。不濫發，不喧嘩。</p>
      <form class="newsletter-form" action="#" method="post">
        <input type="email" class="newsletter-input" placeholder="你的電子郵件地址" aria-label="電子郵件地址" required />
        <button class="newsletter-submit btn-primary" type="submit">訂閱</button>
      </form>
    </div>
  </section>

</PageLayout>

<style>
  /* ── HERO ── */
  .hero {
    position: relative;
    border-bottom: 1px solid var(--hairline);
    overflow: hidden;
  }
  .hero-inner {
    max-width: 1060px;
    margin: 0 auto;
    padding: 4.5rem 2rem 4rem;
    display: grid;
    grid-template-columns: minmax(300px, 1fr) 1.2fr;
    gap: 3rem;
    align-items: center;
  }

  /* 左：直排標題 */
  .hero-left {
    display: flex;
    gap: 2.2rem;
    align-items: flex-start;
    justify-content: center;
  }
  .hero-side {
    writing-mode: vertical-rl;
    font-size: 0.72rem;
    color: var(--ink-muted);
    letter-spacing: 0.55em;
    margin: 0.4rem 0 0;
    padding-top: 0.2rem;
    border-right: 1px solid var(--hairline);
    padding-right: 1.1rem;
    height: 220px;
  }
  .hero-vwrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.2rem;
  }
  .hero-vtitle {
    writing-mode: vertical-rl;
    font-family: 'Noto Serif TC', serif;
    font-size: clamp(2.4rem, 4.6vw, 3.3rem);
    font-weight: 600;
    color: var(--ink);
    letter-spacing: 0.22em;
    line-height: 1.5;
    margin: 0;
  }
  .vcol { display: block; white-space: nowrap; }
  .vcol-2 { margin-top: 2.6rem; margin-right: 0.9rem; color: var(--brown-deep); }
  .hero-seal { font-size: 1.05rem; }

  /* 右：資訊區 */
  .hero-name {
    font-family: 'Noto Serif TC', serif;
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--ink);
    margin: 0 0 1.2rem;
  }
  .hero-desc {
    font-family: 'Noto Serif TC', serif;
    font-size: 0.98rem;
    color: var(--ink-muted);
    font-weight: 300;
    line-height: 2.15;
    letter-spacing: 0.06em;
    margin: 0 0 2rem;
  }
  .hero-cta { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-bottom: 2.6rem; }

  .hero-stats {
    display: flex;
    gap: 0;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0 2.2rem;
    border-left: 1px solid var(--hairline);
  }
  .stat:first-child { padding-left: 0; border-left: none; }
  .stat-num {
    font-family: 'Lora', 'Noto Serif TC', serif;
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.2;
  }
  .stat-label {
    font-size: 0.72rem;
    color: var(--ink-muted);
    letter-spacing: 0.14em;
  }

  /* 右緣直紋 */
  .hero-texture {
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: 90px;
    background: repeating-linear-gradient(
      90deg,
      transparent 0px,
      transparent 7px,
      rgba(90, 72, 50, 0.05) 7px,
      rgba(90, 72, 50, 0.05) 8px
    );
    pointer-events: none;
  }

  /* ── 內容支柱 ── */
  .pillars-section {
    padding: 4.5rem 2rem;
    border-bottom: 1px solid var(--hairline);
  }
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.4rem;
    margin-top: 2.2rem;
  }
  @media (max-width: 1080px) {
    .pillars-grid { grid-template-columns: repeat(2, 1fr); gap: 2.4rem 3rem; }
  }
  .pillar {
    border-top: 1px solid var(--hairline-strong);
    padding-top: 1.4rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.3s;
  }
  .pillar:hover { border-top-color: var(--seal-red); }
  .pillar-head {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: 0.7rem;
  }
  .pillar-num {
    font-family: 'Noto Serif TC', serif;
    font-size: 2rem;
    font-weight: 600;
    color: var(--brown);
    line-height: 1;
  }
  .pillar-title {
    font-size: 1.05rem;
    letter-spacing: 0.12em;
    margin: 0;
  }
  .pillar-desc {
    font-size: 0.83rem;
    color: var(--ink-muted);
    line-height: 2;
    letter-spacing: 0.04em;
    margin: 0;
  }

  /* ── 精選文章 ── */
  .writings-section {
    padding: 4.5rem 2rem;
  }
  .writings-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .writings-head .section-title { margin-bottom: 0; }
  .writings-all {
    font-size: 0.8rem;
    color: var(--brown);
    letter-spacing: 0.12em;
    text-decoration: none;
    white-space: nowrap;
    padding-bottom: 0.3rem;
    transition: color 0.2s;
  }
  .writings-all:hover { color: var(--brown-deep); }

  /* ── 摘句 ── */
  .quote-band {
    padding: 4.5rem 2rem;
    text-align: center;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0px,
        transparent 9px,
        rgba(90, 72, 50, 0.035) 9px,
        rgba(90, 72, 50, 0.035) 10px
      ),
      var(--paper-warm);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .quote-inner { max-width: 720px; margin: 0 auto; }
  .quote-label {
    display: inline-block;
    font-size: 0.72rem;
    color: var(--ink-muted);
    letter-spacing: 0.5em;
    margin-bottom: 1.6rem;
  }
  .quote-text {
    font-family: 'Noto Serif TC', serif;
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    font-weight: 400;
    color: var(--ink);
    line-height: 2.15;
    letter-spacing: 0.08em;
    margin: 0 0 1.6rem;
    border: none;
    padding: 0;
  }
  .quote-author {
    font-size: 0.8rem;
    color: var(--ink-muted);
    letter-spacing: 0.14em;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
  }
  .quote-seal { font-size: 0.62rem; }

  /* ── ABOUT ── */
  .about-section {
    padding: 5rem 2rem;
    border-bottom: 1px solid var(--hairline);
  }
  .about-inner {
    max-width: 1060px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 4.5rem;
    align-items: center;
  }
  .portrait-paper {
    aspect-ratio: 3 / 4;
    border: 1px solid var(--hairline-strong);
    background: var(--paper-blush);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.6rem;
    padding: 1.5rem;
    position: relative;
  }
  .portrait-paper::before {
    content: '';
    position: absolute;
    inset: 8px;
    border: 1px solid var(--hairline);
    pointer-events: none;
  }
  .portrait-char {
    font-family: 'Noto Serif TC', serif;
    font-size: 6.5rem;
    font-weight: 600;
    color: var(--brown);
    opacity: 0.5;
    line-height: 1;
  }
  .portrait-caption {
    font-size: 0.72rem;
    color: var(--ink-muted);
    letter-spacing: 0.3em;
  }
  .about-intro {
    font-family: 'Noto Serif TC', serif;
    font-size: 0.95rem;
    color: var(--ink-muted);
    font-weight: 300;
    line-height: 2.2;
    letter-spacing: 0.05em;
    margin: 0.6rem 0 1.6rem;
    max-width: 520px;
  }
  .about-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .about-tag {
    font-size: 0.74rem;
    padding: 0.32rem 0.9rem;
    border: 1px solid var(--hairline-strong);
    color: var(--ink-soft);
    letter-spacing: 0.14em;
    border-radius: 2px;
  }

  /* ── NEWSLETTER ── */
  .newsletter-section { padding: 5rem 2rem 5.5rem; }
  .newsletter-inner {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }
  .newsletter-title {
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    letter-spacing: 0.12em;
    margin: 0 0 0.8rem;
  }
  .newsletter-desc {
    font-size: 0.85rem;
    color: var(--ink-muted);
    letter-spacing: 0.05em;
    line-height: 2;
    margin: 0 0 2.2rem;
  }
  .newsletter-form {
    display: flex;
    gap: 1.2rem;
    align-items: flex-end;
  }
  .newsletter-input {
    flex: 1;
    padding: 0.6rem 0.2rem;
    border: none;
    border-bottom: 1px solid var(--hairline-strong);
    background: transparent;
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 0.88rem;
    color: var(--ink);
    letter-spacing: 0.06em;
    outline: none;
    border-radius: 0;
    transition: border-color 0.25s;
  }
  .newsletter-input:focus { border-bottom-color: var(--brown); }
  .newsletter-input::placeholder { color: rgba(138, 121, 98, 0.55); }
  .newsletter-submit {
    border: 1px solid var(--brown);
    cursor: pointer;
    font-family: 'Noto Sans TC', sans-serif;
  }

  /* ── SCROLL REVEAL ── */
  @keyframes revealUp {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .scroll-reveal { opacity: 0; transform: translateY(28px); }
  .scroll-reveal.is-visible {
    animation: revealUp 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--delay, 0s);
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-reveal, .scroll-reveal.is-visible {
      opacity: 1; transform: none; animation: none;
    }
  }

  /* ── 直排標題逐字進場 ── */
  :global(.hero-char) {
    display: inline-block;
    opacity: 0;
    transform: translateY(16px);
    animation: heroCharIn 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--ci) * 0.06s + 0.15s);
  }
  @keyframes heroCharIn {
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.hero-char) { opacity: 1; transform: none; animation: none; }
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; gap: 3rem; padding-top: 3rem; }
    .hero-left {
      justify-content: center;
      order: 2;
      padding-top: 2.5rem;
      border-top: 1px solid var(--hairline);
    }
    /* iOS Safari 對小於 16px 的輸入框會在聚焦時自動放大畫面 */
    .newsletter-input { font-size: 16px; }
    /* 擴大觸控範圍到約 44px，不改變外觀 */
    .writings-all { position: relative; }
    .writings-all::after { content: ''; position: absolute; inset: -8px -8px; }
    .hero-right { order: 1; }
    .hero-texture { display: none; }
    .pillars-grid { grid-template-columns: 1fr; gap: 2rem; }
    .about-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .portrait-paper { max-width: 240px; }
    .hero-stats { flex-wrap: wrap; gap: 1rem 0; }
    .stat { padding: 0 1.4rem; }
  }
  /* 標題與副標題只在指定斷點換行，避免窄螢幕把一兩個字擠到下一行 */
  .hero-name .ph,
  .hero-desc .ph { display: inline-block; }

  @media (max-width: 560px) {
    .newsletter-form { flex-direction: column; align-items: stretch; }
    .hero-side { display: none; }
    .hero-right .label-en { letter-spacing: 0.16em; }
    .hero-name { font-size: 1.4rem; letter-spacing: 0.08em; }
  }
</style>

<script>
  // ── SCROLL REVEAL ──
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  document.querySelectorAll('.scroll-reveal').forEach((el) => observer.observe(el));

  // ── 直排標題逐字進場 ──
  (function () {
    const title = document.querySelector('.hero-vtitle');
    if (!title) return;
    let ci = 0;
    title.querySelectorAll('.vcol').forEach((col) => {
      const chars = [...(col.textContent ?? '')];
      col.textContent = '';
      for (const ch of chars) {
        const s = document.createElement('span');
        s.className = 'hero-char';
        s.style.setProperty('--ci', String(ci++));
        s.textContent = ch;
        col.appendChild(s);
      }
    });
  })();
</script>
