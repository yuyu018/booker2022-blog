---
import PageLayout from '../layouts/PageLayout.astro';
import { CATEGORIES, categoryMeta, getPosts, monthLabel, postUrl, readTime, type Post } from '../lib/posts';
import { homeText as t, phrases } from '../lib/site';

const posts = await getPosts();

/* 數字欄填 auto 時，自動換成目前的文章總數 */
const stats = t.stats.map(s => ({ ...s, num: s.num === 'auto' ? String(posts.length) : s.num }));

/* 首頁精選：每個分類取最新一篇 */
const featured = CATEGORIES
  .map(c => posts.find(p => p.data.category === c))
  .filter((p): p is Post => p !== undefined);

const pillars = CATEGORIES.map(c => ({
  num: categoryMeta[c].num,
  title: categoryMeta[c].short,
  desc: categoryMeta[c].pillar,
  href: `/blog/${c}`,
}));
---

<PageLayout title={t.seoTitle} description={t.seoDescription}>

  <!-- ══════════════════════════════════
       HERO：直排標題 × 印章
  ══════════════════════════════════ -->
  <section id="s-hero" class="hero">
    <div class="hero-inner">

      <div class="hero-text">
        <p class="label-en hero-eyebrow">{t.heroLabelEn}</p>
        <h1 class="hero-title">
          <span class="hero-line">{t.heroTitleLine1}</span>
          <span class="hero-line hero-line-accent">{t.heroTitleLine2}</span>
        </h1>
        <p class="hero-name">{phrases(t.heroName).map(s => <span class="ph">{s}</span>)}</p>
        <p class="hero-desc">
          {t.heroDescLines.map((line, i) => (
            <>{i > 0 && <br />}{phrases(line).map(s => <span class="ph">{s}</span>)}</>
          ))}
        </p>
        <div class="hero-cta">
          <a href="/blog" class="btn-primary">{t.heroBtnPrimary}</a>
          <a href="/about" class="btn-secondary">{t.heroBtnSecondary}</a>
        </div>
        <div class="hero-stats">
          {stats.map(s => (
            <div class="stat">
              <span class="stat-num">{s.num}</span>
              <span class="stat-label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>

      <figure class="hero-portrait">
        <img class="hero-avatar" src="/booker-avatar.png" alt="布克小姐" width="256" height="256" decoding="async" />
        <figcaption class="hero-caption">{t.heroSide}</figcaption>
      </figure>

    </div>
  </section>

  <!-- ══════════════════════════════════
       內容支柱 FOUR PILLARS
  ══════════════════════════════════ -->
  <section id="s-pillars" class="pillars-section">
    <div class="section-inner">
      <span class="label-en">{t.pillarsLabelEn}</span>
      <h2 class="section-title">{t.pillarsTitle}</h2>
      <div class="pillars-grid">
        {pillars.map(p => (
          <a href={p.href} class="pillar">
            <div class="pillar-head">
              <span class="pillar-num">{p.num}</span>
              <h3 class="pillar-title">{p.title}</h3>
            </div>
            <p class="pillar-desc">{p.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════
       精選文章 SELECTED WRITINGS
  ══════════════════════════════════ -->
  <section id="s-writings" class="writings-section">
    <div class="section-inner">
      <div class="writings-head">
        <div>
          <span class="label-en">{t.writingsLabelEn}</span>
          <h2 class="section-title">{t.writingsTitle}</h2>
        </div>
        <a href="/blog" class="writings-all">{t.writingsAllLabel}</a>
      </div>
      <div class="writings-list">
        {featured.map((p, i) => (
          <a href={postUrl(p)} class="writing-row scroll-reveal" style={`--delay:${i * 0.12}s`}>
            <span class="writing-num">0{i + 1}</span>
            <div>
              <h3 class="writing-title">{p.data.title}</h3>
              <p class="writing-excerpt">{p.data.description}</p>
            </div>
            <div class="writing-meta">
              {p.data.category && <><span class="m-cat">{categoryMeta[p.data.category].short}</span><span class="m-dot">・</span></>}
              <span>{readTime(p)}</span><span class="m-dot">・</span>
              <span>{monthLabel(p.data.pubDate)}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════
       摘句 QUOTE
  ══════════════════════════════════ -->
  <section id="s-quote" class="quote-band">
    <div class="quote-inner">
      <span class="quote-label scroll-reveal" style="--delay:0s">{t.quoteLabel}</span>
      <blockquote class="quote-text scroll-reveal" style="--delay:0.15s">
        {t.quoteText}
      </blockquote>
      <p class="quote-author scroll-reveal" style="--delay:0.3s">
        {t.quoteAuthor} <span class="seal quote-seal" aria-hidden="true">布克</span>
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════
       ABOUT
  ══════════════════════════════════ -->
  <section id="s-about" class="about-section">
    <div class="about-inner">
      <div class="about-portrait">
        <div class="portrait-paper">
          <img class="portrait-img" src="/booker-avatar.png" alt="布克小姐" width="256" height="256" decoding="async" />
          <span class="portrait-caption">{t.portraitCaption}</span>
        </div>
      </div>
      <div class="about-content">
        <span class="label-en">{t.aboutLabelEn}</span>
        <h2 class="section-title">{t.aboutTitleLine1}<br />{t.aboutTitleLine2}</h2>
        <p class="about-intro">
          {t.aboutIntro}
        </p>
        <div class="about-tags">
          {t.aboutTags.map(tag => <span class="about-tag">{tag}</span>)}
        </div>
        <a href="/about" class="btn-primary">{t.aboutBtn}</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════
       NEWSLETTER
  ══════════════════════════════════ -->
  <section id="s-newsletter" class="newsletter-section">
    <div class="newsletter-inner">
      <h2 class="newsletter-title">{t.newsletterTitle}</h2>
      <p class="newsletter-desc">{t.newsletterDesc}</p>
      <form class="newsletter-form" action="#" method="post">
        <input type="email" class="newsletter-input" placeholder={t.newsletterPlaceholder} aria-label="電子郵件地址" required />
        <button class="newsletter-submit btn-primary" type="submit">{t.newsletterButton}</button>
      </form>
    </div>
  </section>

</PageLayout>

<style>
  /* ── HERO ── */
  .hero {
    position: relative;
  }
  .hero-inner {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: var(--space-section) 2rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 4rem;
    align-items: center;
  }

  .hero-eyebrow { margin-bottom: 1.2rem; }

  /* 標題最大 2rem——份量靠留白，不靠字大 */
  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3.4vw, 2rem);
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.1em;
    color: var(--ink);
    margin: 0 0 1.4rem;
  }
  .hero-line { display: block; }
  .hero-line-accent { color: var(--accent-deep); }

  .hero-name {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink-soft);
    letter-spacing: 0.16em;
    margin: 0 0 1.6rem;
  }
  .hero-desc {
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 2.1;
    letter-spacing: 0.04em;
    margin: 0 0 2.4rem;
    max-width: 34em;
  }
  .hero-cta { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-bottom: 3rem; }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2.6rem;
  }
  .stat { display: flex; flex-direction: column; gap: 0.3rem; }
  .stat-num {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--accent-deep);
    line-height: 1.2;
  }
  .stat-label {
    font-size: 0.74rem;
    color: var(--ink-faint);
    letter-spacing: 0.12em;
  }

  /* 右：頭像卡 */
  .hero-portrait {
    margin: 0;
    background: var(--bg-surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    padding: 2rem 1.5rem 1.4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
  }
  .hero-avatar { width: 140px; height: auto; display: block; }
  .hero-caption {
    font-size: 0.74rem;
    color: var(--ink-faint);
    letter-spacing: 0.22em;
    text-align: center;
  }

  /* ── 內容支柱 ── */
  .pillars-section {
    padding: var(--space-section) 2rem;
    background: var(--bg-soft);
  }
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.6rem;
    margin-top: 2.6rem;
  }
  @media (max-width: 1080px) {
    .pillars-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .pillar {
    background: var(--bg-surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    padding: 1.75rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .pillar:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
  }
  .pillar-head {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin-bottom: 0.8rem;
  }
  .pillar-num {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--accent);
    line-height: 1;
  }
  .pillar-title {
    font-size: 1.05rem;
    letter-spacing: 0.1em;
    margin: 0;
  }
  .pillar-desc {
    font-size: 0.85rem;
    color: var(--ink-soft);
    line-height: 1.95;
    letter-spacing: 0.03em;
    margin: 0;
  }

  /* ── 精選文章 ── */
  .writings-section {
    padding: var(--space-section) 2rem;
  }
  .writings-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .writings-head .section-title { margin-bottom: 0; }
  .writings-all {
    font-size: 0.8rem;
    color: var(--brown);
    letter-spacing: 0.12em;
    text-decoration: none;
    white-space: nowrap;
    padding-bottom: 0.3rem;
    transition: color 0.2s;
  }
  .writings-all:hover { color: var(--brown-deep); }

  /* ── 摘句 ── */
  .quote-band {
    padding: var(--space-section) 2rem;
    text-align: center;
    background: var(--bg-soft);
  }
  .quote-inner { max-width: 720px; margin: 0 auto; }
  .quote-label {
    display: inline-block;
    font-size: 0.72rem;
    color: var(--ink-muted);
    letter-spacing: 0.5em;
    margin-bottom: 1.6rem;
  }
  .quote-text {
    font-family: 'Noto Serif TC', serif;
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    font-weight: 400;
    color: var(--ink);
    line-height: 2.15;
    letter-spacing: 0.08em;
    margin: 0 0 1.6rem;
    border: none;
    padding: 0;
  }
  .quote-author {
    font-size: 0.8rem;
    color: var(--ink-muted);
    letter-spacing: 0.14em;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
  }
  .quote-seal { font-size: 0.62rem; }

  /* ── ABOUT ── */
  .about-section {
    padding: var(--space-section) 2rem;
  }
  .about-inner {
    max-width: var(--wide-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 4.5rem;
    align-items: center;
  }
  .portrait-paper {
    background: var(--bg-surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.4rem;
    padding: 2.4rem 1.5rem 1.8rem;
  }
  .portrait-img {
    width: 66%;
    height: auto;
    display: block;
  }
  .portrait-caption {
    font-size: 0.74rem;
    color: var(--ink-faint);
    letter-spacing: 0.26em;
  }
  .about-intro {
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 2.1;
    letter-spacing: 0.03em;
    margin: 0.6rem 0 1.8rem;
    max-width: 34em;
  }
  .about-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2.2rem;
  }
  .about-tag {
    font-size: 0.76rem;
    padding: 0.36rem 1rem;
    background: var(--bg-soft);
    color: var(--ink-soft);
    letter-spacing: 0.1em;
    border-radius: 999px;
  }

  /* ── NEWSLETTER ── */
  .newsletter-section { padding: 0 2rem var(--space-section); }
  .newsletter-inner {
    max-width: 620px;
    margin: 0 auto;
    text-align: center;
    background: var(--bg-surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    padding: 3rem 2.5rem;
  }
  .newsletter-title {
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    letter-spacing: 0.12em;
    margin: 0 0 0.8rem;
  }
  .newsletter-desc {
    font-size: 0.85rem;
    color: var(--ink-muted);
    letter-spacing: 0.05em;
    line-height: 2;
    margin: 0 0 2.2rem;
  }
  .newsletter-form {
    display: flex;
    gap: 1.2rem;
    align-items: flex-end;
  }
  .newsletter-input {
    flex: 1;
    padding: 0.6rem 0.2rem;
    border: none;
    border-bottom: 1px solid var(--hairline-strong);
    background: transparent;
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 0.88rem;
    color: var(--ink);
    letter-spacing: 0.06em;
    outline: none;
    border-radius: 0;
    transition: border-color 0.25s;
  }
  .newsletter-input:focus { border-bottom-color: var(--brown); }
  .newsletter-input::placeholder { color: rgba(138, 121, 98, 0.55); }
  .newsletter-submit {
    border: 1px solid var(--brown);
    cursor: pointer;
    font-family: 'Noto Sans TC', sans-serif;
  }

  /* ── SCROLL REVEAL ── */
  @keyframes revealUp {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .scroll-reveal { opacity: 0; transform: translateY(28px); }
  .scroll-reveal.is-visible {
    animation: revealUp 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--delay, 0s);
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-reveal, .scroll-reveal.is-visible {
      opacity: 1; transform: none; animation: none;
    }
  }

  /* ── 進場：安靜的淡入上移 ── */
  .hero-text > *,
  .hero-portrait {
    animation: heroIn 0.5s ease-out both;
  }
  .hero-text > *:nth-child(2) { animation-delay: 0.06s; }
  .hero-text > *:nth-child(3) { animation-delay: 0.12s; }
  .hero-text > *:nth-child(4) { animation-delay: 0.18s; }
  .hero-text > *:nth-child(5) { animation-delay: 0.24s; }
  .hero-text > *:nth-child(6) { animation-delay: 0.3s; }
  .hero-portrait { animation-delay: 0.18s; }
  @keyframes heroIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-text > *, .hero-portrait { animation: none; }
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 3.5rem 2rem;
    }
    .hero-portrait { order: -1; align-self: start; max-width: 240px; }
    /* iOS Safari 對小於 16px 的輸入框會在聚焦時自動放大畫面 */
    .newsletter-input { font-size: 16px; }
    /* 擴大觸控範圍到約 44px，不改變外觀 */
    .writings-all { position: relative; }
    .writings-all::after { content: ''; position: absolute; inset: -8px -8px; }
    .pillars-grid { grid-template-columns: 1fr; }
    .about-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .portrait-paper { max-width: 240px; }
    .hero-stats { gap: 1.6rem 2rem; }
    .newsletter-inner { padding: 2.4rem 1.6rem; }
  }
  /* 標題與副標題只在指定斷點換行，避免窄螢幕把一兩個字擠到下一行 */
  .hero-name .ph,
  .hero-desc .ph { display: inline-block; }

  @media (max-width: 560px) {
    .newsletter-form { flex-direction: column; align-items: stretch; }
    .hero-side { display: none; }
    .hero-right .label-en { letter-spacing: 0.16em; }
  }
</style>

<script>
  // ── SCROLL REVEAL ──
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  document.querySelectorAll('.scroll-reveal').forEach((el) => observer.observe(el));
</script>
