---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<html lang="zh-TW">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <div class="grain-overlay" aria-hidden="true"></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>

  <script>
    /* 觸控裝置點擊會觸發 mouseover 卻不觸發 mouseleave，傾斜會卡住，只在滑鼠裝置啟用 */
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches
        && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const applied = new WeakSet();

      function applyTilt(el: HTMLElement) {
        if (applied.has(el)) return;
        applied.add(el);

        const r0 = el.getBoundingClientRect();
        const area = r0.width * r0.height;
        const isWide = r0.width > 620; /* 全寬列表列只做微傾，避免暈眩 */
        const rx = isWide ? 2 : area > 50000 ? 20 : area > 5000 ? 10 : 4;
        const ry = isWide ? 2 : area > 50000 ? 26 : area > 5000 ? 13 : 5;
        const tz = isWide ? 4 : area > 50000 ? 14 : 6;
        const hasLargeShadow = !isWide && area > 5000;

        let gloss: HTMLSpanElement | null = null;
        if (area > 5000) {
          gloss = document.createElement('span');
          gloss.className = 'tilt-gloss';
          if (getComputedStyle(el).position === 'static') el.style.position = 'relative';
          el.appendChild(gloss);
        }

        el.addEventListener('mousemove', (e: MouseEvent) => {
          const r = el.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          el.style.transition = 'transform 0.08s linear, box-shadow 0.08s linear';
          el.style.transform = `perspective(700px) rotateX(${-y * rx}deg) rotateY(${x * ry}deg) translateZ(${tz}px)`;
          if (hasLargeShadow) {
            const sx = x * -18;
            const sy = y * 18 + tz * 0.8;
            const blur = 28 + (Math.abs(x) + Math.abs(y)) * 22;
            el.style.boxShadow = `${sx}px ${sy}px ${blur}px rgba(60,40,10,0.22)`;
          }
          if (gloss) {
            gloss.style.setProperty('--gx', `${(x + 0.5) * 100}%`);
            gloss.style.setProperty('--gy', `${(y + 0.5) * 100}%`);
            gloss.style.opacity = '1';
          }
        }, { passive: true });

        el.addEventListener('mouseleave', () => {
          el.style.transition = 'transform 0.6s cubic-bezier(0.23,1,0.32,1), box-shadow 0.5s ease';
          el.style.transform = '';
          el.style.boxShadow = '';
          if (gloss) gloss.style.opacity = '0';
        });
      }

      document.addEventListener('mouseover', (e: MouseEvent) => {
        const target = e.target as HTMLElement;
        const el = target.closest<HTMLElement>('a[href], button, [role="button"], input[type="submit"], input[type="button"]');
        if (el) { applyTilt(el); return; }
        if (getComputedStyle(target).cursor === 'pointer') applyTilt(target);
      }, { passive: true });
    }
  </script>
</html>