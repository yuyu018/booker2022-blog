---
const today = new Date();
---

<footer class="site-footer">
  <div class="footer-inner">

    <!-- Brand -->
    <div class="footer-brand">
      <p class="footer-logo">布克小姐｜Booker</p>
      <p class="footer-tagline">用文字記錄思考，以閱讀照亮前路。</p>
    </div>

    <!-- Nav -->
    <div class="footer-col">
      <p class="footer-col-title">快速導覽</p>
      <ul class="footer-links">
        <li><a href="/">首頁</a></li>
        <li><a href="/services">服務項目</a></li>
        <li><a href="/about">關於我們</a></li>
        <li><a href="/contact">聯絡資訊</a></li>
      </ul>
    </div>

    <!-- Blog -->
    <div class="footer-col">
      <p class="footer-col-title">精選文章</p>
      <ul class="footer-links">
        <li><a href="/blog/money">金錢</a></li>
        <li><a href="/blog/life">生活</a></li>
        <li><a href="/blog/reading">閱讀</a></li>
        <li><a href="/blog/growth">自我成長</a></li>
        <li><a href="/blog">所有文章</a></li>
      </ul>
    </div>

    <!-- Seal -->
    <div class="footer-seal-col">
      <span class="seal footer-seal" aria-hidden="true">布克</span>
    </div>

  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <p class="footer-copy">© {today.getFullYear()} 布克小姐｜Booker・版權所有</p>
  </div>
</footer>

<style>
  .site-footer {
    background: #2b2115;
    color: rgba(240, 232, 216, 0.62);
    font-family: 'Noto Sans TC', 'PingFang TC', 'Microsoft JhengHei', sans-serif;
    padding: 4rem 2rem 0;
  }

  .footer-inner {
    max-width: 1060px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr auto;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(240, 232, 216, 0.1);
  }

  .footer-logo {
    font-family: 'Noto Serif TC', serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: rgba(246, 240, 228, 0.95);
    margin: 0 0 0.8rem;
    letter-spacing: 0.14em;
  }
  .footer-tagline {
    font-size: 0.8rem;
    line-height: 2;
    color: rgba(240, 232, 216, 0.42);
    margin: 0;
    letter-spacing: 0.08em;
    max-width: 280px;
  }

  .footer-col-title {
    font-family: 'Lora', serif;
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(240, 232, 216, 0.35);
    margin: 0 0 1.1rem;
  }
  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer-links a {
    font-size: 0.83rem;
    color: rgba(240, 232, 216, 0.55);
    text-decoration: none;
    letter-spacing: 0.1em;
    transition: color 0.2s;
  }
  .footer-links a:hover { color: #d8b98a; }

  .footer-seal-col {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
  }
  .footer-seal { font-size: 1.02rem; }

  .footer-bottom {
    max-width: 1060px;
    margin: 0 auto;
    padding: 1.4rem 0 1.8rem;
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    color: rgba(240, 232, 216, 0.28);
  }
  .footer-bottom p { margin: 0; }

  @media (max-width: 768px) {
    .footer-inner { grid-template-columns: 1fr 1fr; gap: 2rem 1.5rem; }
    .footer-brand { grid-column: 1 / -1; }
    .footer-seal-col { display: none; }
    .footer-col-title { font-size: 0.7rem; margin-bottom: 0.3rem; }
    .footer-links { gap: 0; }
    .footer-links a { display: block; padding: 0.6rem 0; }
  }
</style>
