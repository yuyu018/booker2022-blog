---
const today = new Date();
---

<footer class="site-footer">
  <div class="footer-inner">

    <!-- Brand -->
    <div class="footer-brand">
      <p class="footer-logo"><span class="ph">布克小姐｜</span><span class="ph">再富養一次</span></p>
      <p class="footer-tagline">用文字記錄思考，以閱讀照亮前路。</p>
      <span class="seal footer-seal" aria-hidden="true">布克</span>
    </div>

    <!-- Nav -->
    <div class="footer-col">
      <p class="footer-col-title">快速導覽</p>
      <ul class="footer-links">
        <li><a href="/">首頁</a></li>
        <li><a href="/services">服務項目</a></li>
        <li><a href="/about">關於我們</a></li>
        <li><a href="/contact">聯絡資訊</a></li>
      </ul>
    </div>

    <!-- Blog -->
    <div class="footer-col">
      <p class="footer-col-title">精選文章</p>
      <ul class="footer-links">
        <li><a href="/blog/money">金錢</a></li>
        <li><a href="/blog/life">生活</a></li>
        <li><a href="/blog/reading">閱讀</a></li>
        <li><a href="/blog/growth">自我成長</a></li>
        <li><a href="/blog">所有文章</a></li>
      </ul>
    </div>

  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <p class="footer-copy">© {today.getFullYear()} 布克小姐・版權所有</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-soft);
    color: var(--ink-soft);
    padding: 5rem 2rem 0;
    margin-top: var(--space-section);
  }

  .footer-inner {
    max-width: var(--wide-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--line);
  }

  .footer-logo {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 0.7rem;
    letter-spacing: 0.06em;
  }
  .footer-logo .ph { display: inline-block; }
  .footer-tagline {
    font-size: 0.88rem;
    line-height: 1.9;
    color: var(--ink-soft);
    margin: 0 0 1.4rem;
    max-width: 320px;
  }
  .footer-seal { font-size: 0.68rem; }

  .footer-col-title {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--ink);
    margin: 0 0 1rem;
  }
  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .footer-links a {
    font-size: 0.88rem;
    color: var(--ink-soft);
    letter-spacing: 0.04em;
    transition: color 0.25s ease;
  }
  .footer-links a:hover { color: var(--accent); }

  .footer-bottom {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: 1.6rem 0 2rem;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }
  .footer-bottom p { margin: 0; }

  @media (max-width: 768px) {
    .site-footer { padding: 3.5rem 1.5rem 0; }
    .footer-inner { grid-template-columns: 1fr 1fr; gap: 2rem 1.5rem; }
    .footer-brand { grid-column: 1 / -1; }
    .footer-links { gap: 0; }
    .footer-links a { display: block; padding: 0.6rem 0; }
  }
</style>
