---
interface Props {
  label: string;        /* 英文眉標，如 OUR SERVICES */
  labelZh?: string;     /* 中文小標（可省略） */
  title: string;
  titleAccent?: string; /* 標題後半段，會用強調色顯示 */
}
const { label, labelZh, title, titleAccent } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero-inner">
    <span class="label-en">{label}</span>
    {labelZh && <span class="page-hero-zh">{labelZh}</span>}
    <h1 class="page-hero-title">{title}{titleAccent && <em>{titleAccent}</em>}</h1>
    <p class="page-hero-desc"><slot /></p>
  </div>
</section>

<style>
  .page-hero {
    padding: calc(var(--space-section) * 0.75) 2rem calc(var(--space-section) * 0.5);
    border-bottom: 1px solid var(--hairline);
    background: var(--paper);
  }
  .page-hero-inner {
    max-width: var(--wide-width);
    margin: 0 auto;
  }
  .page-hero-zh {
    display: block;
    font-size: 0.78rem;
    color: var(--brown);
    letter-spacing: 0.3em;
    margin-bottom: 0.5rem;
  }
  .page-hero-title {
    font-family: 'Noto Serif TC', serif;
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.5;
    margin: 0.4rem 0 1.2rem;
    letter-spacing: 0.1em;
  }
  .page-hero-title :global(em) {
    font-style: normal;
    color: var(--brown);
  }
  .page-hero-desc {
    font-family: 'Noto Serif TC', serif;
    font-size: 0.98rem;
    color: var(--ink-muted);
    line-height: 2.1;
    font-weight: 300;
    margin: 0;
    letter-spacing: 0.06em;
    max-width: 560px;
  }
</style>
