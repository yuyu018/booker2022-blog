---
import type { Page } from 'astro';
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from './PageHero.astro';
import PostSearch from './PostSearch.astro';
import Pagination from './Pagination.astro';
import { categoryMeta, monthLabel, postUrl, readTime, type Category, type Post } from '../lib/posts';
import { blogText as t, site } from '../lib/site';

interface Props {
  slug: Category;
  page: Page<Post>;
}
const { slug, page } = Astro.props;
const meta = categoryMeta[slug];
const base = `/blog/${slug}`;
---

<PageLayout
  title={page.currentPage > 1 ? `${meta.title}（第 ${page.currentPage} 頁）— ${site.siteTitle}` : `${meta.title} — ${site.siteTitle}`}
  description={meta.desc}
>

  <PageHero label={meta.labelEn} labelZh={t.categoryLabelZh} title={meta.title}>
    {meta.desc}
  </PageHero>

  <section class="cat-list-section">
    <div class="section-inner">
      <PostSearch category={meta.title} />

      <div data-search-hides>
        <div class="cat-count">
          {`${t.categoryCountBefore} ${page.total} ${t.categoryCountAfter}`}
          {page.lastPage > 1 && <span class="cat-page">・第 {page.currentPage} / {page.lastPage} 頁</span>}
        </div>

        {page.total === 0 && (
          <p class="cat-empty">{t.categoryEmpty}</p>
        )}

        {page.data.map((p, i) => (
          <a href={postUrl(p)} class="writing-row">
            <span class="writing-num">{String(page.start + i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="writing-title">{p.data.title}</h3>
              <p class="writing-excerpt">{p.data.description}</p>
            </div>
            <div class="writing-meta">
              <span>{readTime(p)}</span><span class="m-dot">・</span>
              <span>{monthLabel(p.data.pubDate)}</span>
            </div>
          </a>
        ))}

        <Pagination current={page.currentPage} total={page.lastPage} url={page.url} base={base} />
      </div>

      <div class="cat-more">
        <p class="cat-more-text">{t.categoryMoreText}</p>
        <div class="cat-more-cta">
          <a href="/#s-newsletter" class="btn-primary">{t.categoryMoreBtnPrimary}</a>
          <a href="/blog" class="btn-secondary">{t.categoryMoreBtnSecondary}</a>
        </div>
      </div>
    </div>
  </section>

</PageLayout>

<style>
  .cat-list-section { padding: calc(var(--space-section) * 0.6) 2rem var(--space-section); }
  .cat-count {
    font-size: 0.74rem;
    color: var(--ink-muted);
    letter-spacing: 0.2em;
    margin-bottom: 1.4rem;
  }
  .cat-empty {
    font-family: 'Noto Serif TC', serif;
    color: var(--ink-muted);
    letter-spacing: 0.08em;
    padding: 2rem 0;
    border-top: 1px solid var(--hairline);
  }
  .cat-more {
    margin-top: 3.5rem;
    text-align: center;
  }
  .cat-more-text {
    font-family: 'Noto Serif TC', serif;
    font-size: 0.9rem;
    color: var(--ink-muted);
    letter-spacing: 0.08em;
    margin: 0 0 1.6rem;
  }
  .cat-more-cta {
    display: flex;
    gap: 0.9rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
